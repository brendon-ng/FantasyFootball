# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# local subpath preview staged by `npm run preview`
/.preview/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sleeper 5MB player-map cache
/.cache/

# staged per-league builds
/.assembled/

# ESPN session cookies for importing a PRIVATE league's history. Never commit
# these — `espn_s2` is a session token for the whole ESPN account, not just one
# league. Read only by the import scripts, only when present.
.espn-auth.json
