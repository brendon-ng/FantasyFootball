{
  "name": "fantasy-football",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-all.mjs",
    "preview": "npm run build && rm -rf .preview && mkdir -p .preview && cp -R out .preview/FantasyFootball && npx --yes serve .preview -l 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "clean": "rm -rf .next out .preview .assembled",
    "sync": "node scripts/sync.ts",
    "derive": "node scripts/derive.ts",
    "data": "npm run sync && npm run adp && npm run derive && npm run import:player-teams",
    "adp": "node scripts/adp.ts",
    "adp:lock": "node scripts/adp.ts --lock",
    "import:espn": "node scripts/import-espn.ts",
    "import:espn:lineups": "node scripts/import-espn-lineups.ts",
    "import:espn:drafts": "node scripts/import-espn-drafts.ts",
    "import:espn:transactions": "node scripts/import-espn-transactions.ts",
    "import:player-teams": "node scripts/import-player-teams.ts",
    "build:one": "next build"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
